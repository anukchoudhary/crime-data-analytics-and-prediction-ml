{
  "version": 2,
  "functions": {
    "api/index.py": {
      "excludeFiles": "{static/**,data/previous_dataset.csv,models/confusion_matrix.png}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/",
      "destination": "/static/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
